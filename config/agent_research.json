{
  "schema_version": 1,
  "market_data": {
    "primary_source": "longbridge",
    "fallback_source": "twelve",
    "fixture_mode": true
  },
  "providers": {
    "fundamentals": {
      "mode": "fixture",
      "live_enabled": false,
      "required_evidence_fields": [
        "evidence_id",
        "source",
        "source_type",
        "as_of",
        "symbol",
        "summary",
        "confidence",
        "limitations"
      ]
    },
    "news": {
      "mode": "fixture",
      "live_enabled": false,
      "required_evidence_fields": [
        "evidence_id",
        "source",
        "source_type",
        "published_at",
        "symbol",
        "summary",
        "confidence",
        "limitations"
      ]
    },
    "sentiment": {
      "mode": "fixture",
      "live_enabled": false,
      "required_evidence_fields": [
        "evidence_id",
        "source",
        "source_type",
        "as_of",
        "symbol",
        "summary",
        "confidence",
        "limitations"
      ]
    },
    "external_disclosures": {
      "mode": "open_cabinet",
      "live_enabled": true,
      "official_slug": "trump-donald-j",
      "source_url": "https://open-cabinet.org/data/full-dataset.json",
      "lookback_days": 120,
      "output": "report/<DATE>/external-disclosures/trump-trades.json",
      "required_evidence_fields": [
        "evidence_id",
        "source",
        "source_type",
        "source_subtype",
        "published_at",
        "symbol",
        "summary",
        "confidence",
        "limitations"
      ]
    },
    "vibe_swarm": {
      "mode": "codex_mcp_artifact",
      "live_enabled": true,
      "preset_name": "tca_research_review",
      "default_provider": "openai-codex",
      "default_model": "openai-codex/gpt-5.6-sol",
      "effective_model": "gpt-5.6-sol",
      "reasoning_effort": "medium",
      "output": "report/<DATE>/agents/vibe-research-context.json",
      "scheduled_max_escalations": 1,
      "can_raise_execution_status": false,
      "can_call_broker": false,
      "required_run_fields": [
        "run_id",
        "status",
        "target",
        "symbols",
        "objective",
        "as_of",
        "quality_label",
        "confidence",
        "artifacts",
        "limitations"
      ]
    }
  },
  "safety": {
    "decision_artifacts_not_orders": true,
    "memory_can_raise_execution_status": false,
    "broker_writes_allowed": false
  }
}
